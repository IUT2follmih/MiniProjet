<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ListeExoActivity">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center">

        <Button
            style="@style/Widget.Material3.Button.ElevatedButton.Icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/Creation_button_text_retour"
            android:layout_margin="20dp"
            android:onClick="btnRetour"
            app:icon="@drawable/baseline_arrow_back_24"
            />

        <TextView
            android:id="@+id/Liste_text_title"
            android:text="@string/List_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textSize="30dp"
            android:layout_marginRight="20dp"/>
    </LinearLayout>


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:layout_marginTop="100dp"
        android:layout_marginHorizontal="20dp"
        android:gravity="center">

        <Button
            style="@style/Widget.Material3.Button.ElevatedButton.Icon"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/List_btn_TableDeMult"
            android:onClick="onExoTableDeMult"
            app:icon="@drawable/baseline_calculate_24"
            android:layout_marginBottom="10dp"/>

        <Button
            style="@style/Widget.Material3.Button.ElevatedButton.Icon"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/List_btn_TableDadd"
            android:onClick="onExoTableDadd"
            app:icon="@drawable/baseline_calculate_24"
            android:layout_marginBottom="10dp"/>

        <Button
            style="@style/Widget.Material3.Button.ElevatedButton.Icon"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/List_btn_QCM"
            android:onClick="onExoQCM"
            app:icon="@drawable/baseline_checklist_rtl_24"
            android:layout_marginBottom="10dp"/>

    </LinearLayout>
</RelativeLayout>