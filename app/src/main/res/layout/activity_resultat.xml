<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ResultatActivity">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:id="@+id/Result_text_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/Result_text_title"
            android:textSize="40dp" />

        <TextView
            android:id="@+id/Result_text_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/Result_text_name"
            android:textSize="20dp" />

        <TextView
            android:id="@+id/Result_text_nbOk"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/Result_text_nbOk"/>

        <TextView
            android:id="@+id/Result_text_nbError"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/Result_text_nbError"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="50dp"
        android:gravity="center"
        android:orientation="vertical">

        <Button
            android:id="@+id/Result_btn_retour_exo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/Result_btn_retour_exo" />

        <Button
            android:id="@+id/Result_btn_retour_comptes"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/Result_btn_retour_comptes" />
    </LinearLayout>
</RelativeLayout>